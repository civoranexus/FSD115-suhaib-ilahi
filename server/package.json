{
  "name": "livestockhub-backend",
  "version": "1.0.0",
  "description": "Scalable backend for LiveStockHub - Digital Cattle Marketplace",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon --experimental-specifier-resolution=node src/index.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "db:migrate": "node database/migrations/init.js",
    "db:seed": "node database/seeds/seedData.js",
    "db:reset": "node database/scripts/reset.js",
    "lint": "eslint src/",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "keywords": [
    "livestock",
    "cattle",
    "marketplace",
    "e-commerce",
    "bidding",
    "auction"
  ],
  "author": "LiveStockHub Team",
  "license": "MIT",
  "dependencies": {
    "@faker-js/faker": "^10.2.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "express": "^5.2.1",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.12",
    "pg": "^8.16.3",
    "postgres": "^3.4.8",
    "redis": "^5.10.0",
    "socket.io": "^4.8.3",
    "supertest": "^7.2.2",
    "uuid": "^13.0.0",
    "winston": "^3.19.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=8.0.0"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "nodemon": "^3.1.11"
  }
}
